<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/buildingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.example.dbtest.map.SiteMapView
            android:id="@+id/siteMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/buildingName"
            android:layout_above="@id/floatingActionButton"
            android:layout_marginTop="29dp"
            android:contentDescription="@string/CampuSpot" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compassOverlay"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Compass" />

        <LinearLayout
            android:id="@+id/legendCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:background="@drawable/legend_bg"
            android:padding="8dp">

            <TextView
                android:id="@+id/legendHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map Key ▾"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/legendLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/floorToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="24dp"
            android:text="Floor 1"
            android:contentDescription="Toggle floor" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/floatingActionButton"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D"
                android:textColor="#000000"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="200dp">

                <SeekBar
                    android:id="@+id/tiltSeek"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:max="65"
                    android:progress="0"
                    android:rotation="270"
                    android:contentDescription="3D tilt" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:src="@drawable/settings_logo"
            android:tint="@color/purple_500"
            android:tintMode="add" />

    </RelativeLayout>

    <include
        android:id="@+id/slider_root"
        layout="@layout/slider" />

</FrameLayout>